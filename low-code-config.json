{
  "name": "Smart Campus Room Availability Checker",
  "room": "301",
  "timezone": "UTC+05:00",
  "bookings": [
    {
      "id": "B001",
      "start": "2026-12-01T10:00:00+05:00",
      "end": "2026-12-01T11:00:00+05:00"
    },
    {
      "id": "B002",
      "start": "2026-12-01T12:00:00+05:00",
      "end": "2026-12-01T13:30:00+05:00"
    },
    {
      "id": "B003",
      "start": "2026-12-01T15:00:00+05:00",
      "end": "2026-12-01T16:00:00+05:00"
    }
  ],
  "controls": [
    {
      "type": "datetime-local",
      "id": "start",
      "label": "Start date and time (UTC+05:00)"
    },
    {
      "type": "text",
      "id": "duration",
      "label": "Duration (minutes)"
    },
    {
      "type": "checkbox",
      "id": "blocked",
      "label": "Room blocked"
    }
  ],
  "rules": [
    {
      "condition": "invalidDate",
      "reason": "INVALID_DATE",
      "message": "Validation error: Select a valid start time."
    },
    {
      "condition": "pastStart",
      "reason": "PAST_START",
      "message": "Validation error: Start time must be in the future."
    },
    {
      "condition": "invalidDuration",
      "reason": "INVALID_DURATION",
      "message": "Validation error: Duration must be greater than 0 and at most 120 minutes."
    },
    {
      "condition": "blocked",
      "reason": "ROOM_BLOCKED",
      "message": "Unavailable: The room is blocked."
    },
    {
      "condition": "overlap",
      "reason": "BOOKING_OVERLAP",
      "message": "Unavailable: Conflicts with booking {id}."
    },
    {
      "condition": "otherwise",
      "reason": "AVAILABLE",
      "message": "Available: No conflicting bookings found."
    }
  ]
}